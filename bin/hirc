#!/usr/bin/env python3
"""hirc — IRC-style messaging between agents running in Herdr panes.

Wraps `herdr agent` commands. Agents are addressed by their live agent name
(`herdr agent rename` / `herdr agent start <name>`) or by pane id (`wG:p1`).
Append `@<machine>` or pass `--machine` to reach agents on a saved SSH machine.

Ops:
  hirc whoami                     your address (name or pane id) + status
  hirc list                       roster of live agents on this server
  hirc nick <name>                register a memorable name for your pane
  hirc send <to> <message...>     message (`to` = name, pane id, '#channel', 'all')
                                  busy peers get one coalesced turn on idle; --now overrides
  hirc reply <id> <message...>    reply to a message by its id
  hirc inbox [--peek|--all]       read your durable mail; marks it seen
  hirc check                      exit 0 when new mail is waiting (cheap)
  hirc flush [to]                 deliver queued coalesced messages now
  hirc ask <to> <message...>      send, wait for the peer to settle, print its reply
  hirc read <to>                  tail a peer's output
  hirc wait <to>                  block until the peer settles
  hirc machines                   saved SSH machine profiles
  hirc log [--all]                local send/delivery log
  hirc skill                      print the agent skill doc (protocol)
"""

import json
import os
import re
import secrets
import socket
import subprocess
import sys
import time

VERSION = "0.2.0"
NAME_RE = re.compile(r"[a-z][a-z0-9_-]{0,31}$")
STATE_DIR = os.path.expanduser("~/.local/state/herdr/plugins/hirc")
LOG_FILE = os.path.join(STATE_DIR, "messages.jsonl")
MAIL_DIR = os.path.join(STATE_DIR, "mail")
PEND_DIR = os.path.join(STATE_DIR, "pending")
SKILL_PATH = os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "skills", "hirc", "SKILL.md")


def die(msg, code=1):
    print(f"hirc: {msg}", file=sys.stderr)
    sys.exit(code)


def herdr(args, machine=None, capture_text=False):
    """Run a herdr CLI command. Returns (ok, parsed_or_text, error_dict)."""
    cmd = ["herdr"] + (["--machine", machine] if machine else []) + args
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
    except FileNotFoundError:
        die("`herdr` not found in PATH — hirc only works on a Herdr host")
    except subprocess.TimeoutExpired:
        return False, None, {"code": "timeout", "message": "herdr CLI timed out"}
    out, err = p.stdout, p.stderr
    for blob in (out, err):
        blob = blob.strip()
        if not blob:
            continue
        try:
            data = json.loads(blob)
        except json.JSONDecodeError:
            continue
        if isinstance(data, dict) and "error" in data:
            return False, None, data["error"]
        return True, (data.get("result", data) if isinstance(data, dict) else data), None
    if p.returncode != 0:
        return False, None, {"code": "cli_error", "message": (err or out).strip() or f"exit {p.returncode}"}
    return (True, out, None) if capture_text else (True, out, None)


def hostname():
    return socket.gethostname().split(".")[0] or "local"


_ROSTER_CACHE = {}


def roster(machine=None):
    if machine in _ROSTER_CACHE:
        return _ROSTER_CACHE[machine]
    ok, data, err = herdr(["agent", "list"], machine=machine)
    if not ok:
        die(f"cannot list agents: {err.get('code')} — {err.get('message')}")
    _ROSTER_CACHE[machine] = data.get("agents", [])
    return _ROSTER_CACHE[machine]


def agent_addr(entry):
    return entry.get("name") or entry["pane_id"]


def my_identity():
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane:
        return None
    for a in roster():
        if a.get("pane_id") == pane:
            return a
    return {"pane_id": pane, "agent": "?", "agent_status": "unknown"}


def my_address():
    if os.environ.get("HIRC_FROM"):
        return os.environ["HIRC_FROM"]
    me = my_identity()
    return agent_addr(me) if me else f"user@{hostname()}"


def split_target(target, default_machine):
    """'name@machine' → (name, machine). '@local'/own hostname → local."""
    if "@" in target:
        name, _, mach = target.rpartition("@")
        if mach in ("", "local", hostname()):
            return name, default_machine
        return name, mach
    return target, default_machine


def envelope(msg):
    """Self-documenting wire format: id + routing header + reply hint + body."""
    reply_addr = msg["from"] if "@" in msg["from"] else f"{msg['from']}@{hostname()}"
    head = f"[hirc {msg['id']} from {reply_addr} — reply: hirc reply {msg['id']} \"msg\"]"
    if msg.get("reply_to"):
        head = head.replace(" from ", f" re:{msg['reply_to']} from ")
    return f"{head}\n{msg['body']}"


HUMAN_ALIASES = {"human", "user", "me", "you"}


# --- durable mail layer ------------------------------------------------------
# SAMP-style: one append-only outbox file per writer (mail/out-<addr>.jsonl),
# so concurrent writers never race. Readers union all files and track a
# watermark (.seen-<me>.json). mail/ survives restarts — that IS the inbox.

def _fname(addr):
    return re.sub(r"[^A-Za-z0-9_.-]", "_", addr)


def append_jsonl(path, obj, cap=512_000, keep=4000):
    """Append one JSON line; trims the head when the file outgrows the cap."""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.exists(path) and os.path.getsize(path) > cap:
            lines = open(path).read().splitlines()[-keep:]
            with open(path, "w") as f:
                f.write("\n".join(lines) + "\n")
        with open(path, "a") as f:
            f.write(json.dumps(obj) + "\n")
    except OSError:
        pass


def new_msg(to, body, channel=None, reply_to=None):
    m = {"id": secrets.token_hex(3), "ts": time.time(),
         "from": my_address(), "to": to, "body": body}
    if channel:
        m["channel"] = channel
    if reply_to:
        m["reply_to"] = reply_to
    return m


def mail_append(m):
    append_jsonl(os.path.join(MAIL_DIR, f"out-{_fname(addr_base(m['from']))}.jsonl"), m)


def mail_scan():
    """All mail messages, oldest first."""
    try:
        files = sorted(os.listdir(MAIL_DIR))
    except OSError:
        return []
    out = []
    for fn in files:
        if not fn.startswith("out-"):
            continue
        try:
            for line in open(os.path.join(MAIL_DIR, fn)):
                try:
                    out.append(json.loads(line))
                except json.JSONDecodeError:
                    pass
        except OSError:
            pass
    return sorted(out, key=lambda m: m.get("ts", 0))


def mail_find(id_prefix):
    for m in mail_scan():
        if m.get("id", "").startswith(id_prefix):
            return m
    return None


def _seen_file(me):
    return os.path.join(MAIL_DIR, f".seen-{_fname(me)}.json")


def seen_ts(me):
    try:
        return json.load(open(_seen_file(me))).get("ts", 0)
    except (OSError, json.JSONDecodeError):
        return 0


def mark_seen(me, ts):
    try:
        os.makedirs(MAIL_DIR, exist_ok=True)
        with open(_seen_file(me), "w") as f:
            json.dump({"ts": ts}, f)
    except OSError:
        pass


def my_inbox_addr():
    """Who 'me' is for inbox purposes: pane identity, HIRC_FROM, or the human."""
    if not os.environ.get("HERDR_PANE_ID") and not os.environ.get("HIRC_FROM"):
        return "human"
    return addr_base(my_address())


# --- pending (coalescing) ----------------------------------------------------
# Messages to a busy peer accumulate in pending/<target>.jsonl and flush as ONE
# merged turn when the peer goes idle (or on the next send/flush to it).

def pend_append(m):
    append_jsonl(os.path.join(PEND_DIR, _fname(m["to"]) + ".jsonl"), m)


def pend_drain(target):
    """Pop all pending messages for a target — atomic claim via rename, so a
    concurrent flush (daemon sweep vs manual) can't double-deliver."""
    path = os.path.join(PEND_DIR, _fname(target) + ".jsonl")
    claim = f"{path}.{os.getpid()}.claim"
    try:
        os.rename(path, claim)
    except OSError:
        return []
    try:
        return [json.loads(l) for l in open(claim)]
    except (OSError, json.JSONDecodeError):
        return []
    finally:
        try:
            os.unlink(claim)
        except OSError:
            pass


def pend_all():
    try:
        return [f[:-6] for f in os.listdir(PEND_DIR) if f.endswith(".jsonl")]
    except OSError:
        return []


def merged_envelope(msgs):
    """One or many pending messages → a single prompt payload."""
    if len(msgs) == 1:
        return envelope(msgs[0])
    lines = [f"[hirc {msgs[-1]['id']} — {len(msgs)} messages — reply to any with: hirc reply <id> \"msg\"]"]
    for m in msgs:
        lines.append(f"--- {m['id']} from {m['from']}: {m['body']}")
    return "\n".join(lines)


def log_msg(direction, target, body, result, machine=None, channel=None,
            msg_id=None, reply_to=None):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        entry = {
            "ts": int(time.time()), "dir": direction, "from": my_address(),
            "to": target, "machine": machine or "local",
            "result": result, "body": body,
        }
        if channel:
            entry["channel"] = channel
        if msg_id:
            entry["id"] = msg_id
        if reply_to:
            entry["re"] = reply_to
        append_jsonl(LOG_FILE, entry)
    except OSError:
        pass


def my_workspace(machine=None):
    """My pane's workspace_id, or None when not running inside a Herdr pane."""
    mine = os.environ.get("HERDR_PANE_ID")
    if not mine:
        return None
    for a in roster(machine):
        if a.get("pane_id") == mine:
            return a.get("workspace_id")
    return None


def addr_base(addr):
    """'name@host' or 'name' → 'name'."""
    return (addr or "?").split("@")[0]


def ws_members(ws_id, machine=None):
    """Set of name+pane_id addresses for agents in a workspace."""
    out = set()
    for a in roster(machine):
        if a.get("workspace_id") == ws_id:
            out.add(a.get("pane_id"))
            out.add(a.get("name"))
    return out - {None}


def resolve_channel(name, machine=None):
    """'#label-or-id' → workspace dict. Exact, then prefix, then substring."""
    ok, data, err = herdr(["workspace", "list"], machine=machine)
    if not ok:
        die(f"cannot list workspaces: {err.get('code')} — {err.get('message')}")
    wss = data.get("workspaces", [])
    want = name.lstrip("#").lower()
    names = lambda w: (w.get("workspace_id", "").lower(), (w.get("label") or "").lower())
    hit = [w for w in wss if want in names(w)]
    if not hit:
        hit = [w for w in wss if any(n.startswith(want) for n in names(w) if n)]
    if not hit:
        hit = [w for w in wss if any(want in n for n in names(w) if n)]
    if len(hit) == 1:
        return hit[0]
    die(f"channel '#{want}' matched {len(hit)} workspaces — known: " +
        ", ".join(f"#{w.get('label') or w['workspace_id']}" for w in wss))


def deliver(target, text, machine=None):
    """One fire-and-forget delivery. Returns (receipt, detail)."""
    ok, _, err = herdr(["agent", "prompt", target, text], machine=machine)
    if ok:
        return "delivered", ""
    code = err.get("code", "error")
    return ("blocked" if code == "agent_blocked" else f"failed:{code}"), err.get("message", "")


def cmd_whoami(args):
    me = my_identity()
    if not me:
        die("not inside a Herdr-managed pane (HERDR_PANE_ID unset); no agent identity")
    me = dict(me)
    me["address"] = agent_addr(me)
    me["machine"] = hostname()
    if args.json:
        print(json.dumps(me, indent=1))
    else:
        print(f"{me['address']}@{me['machine']}  ({me.get('agent')}, {me.get('agent_status')}, pane {me['pane_id']})")
        if not me.get("name"):
            print(f"no name registered — reachable as '{me['pane_id']}'; set one with: hirc nick <name>")


def cmd_list(args):
    agents = roster(machine=args.machine)
    if args.json:
        print(json.dumps([{
            "address": agent_addr(a), "kind": a.get("agent"), "status": a.get("agent_status"),
            "pane": a.get("pane_id"), "workspace": a.get("workspace_id"),
            "cwd": a.get("cwd"), "title": a.get("terminal_title_stripped"),
        } for a in agents], indent=1))
        return
    if not agents:
        print("(no live agents)")
        return
    mine = os.environ.get("HERDR_PANE_ID")
    print(f"{'ADDRESS':<22} {'KIND':<10} {'STATUS':<8} {'PANE':<8} CWD")
    for a in agents:
        addr = agent_addr(a) + (" (you)" if a.get("pane_id") == mine else "")
        print(f"{addr:<22} {a.get('agent','?'):<10} {a.get('agent_status','?'):<8} {a.get('pane_id','?'):<8} {a.get('cwd','')}")


def cmd_nick(args):
    name = args.name
    if not NAME_RE.match(name):
        die(f"invalid name '{name}' — must match [a-z][a-z0-9_-]{{0,31}}")
    if name in HUMAN_ALIASES:
        die(f"'{name}' is reserved for the human mailbox — pick another")
    pane = os.environ.get("HERDR_PANE_ID") or die("not inside a Herdr pane; cannot self-register")
    ok, _, err = herdr(["agent", "rename", pane, name])
    if not ok:
        die(f"rename failed: {err.get('code')} — {err.get('message')}")
    print(f"you are now '{name}' — peers reach you with: hirc send {name} \"...\"")


def agent_status(addr, machine=None):
    """Live status of a local target, or None."""
    base = addr_base(addr)
    for a in roster(machine):
        if base in (a.get("name"), a.get("pane_id")):
            return a.get("agent_status")
    return None


def send_to(name, mach, body, channel=None, reply_to=None, defer=True):
    """Append to durable mail, then deliver now or queue for coalesced flush."""
    where = f"{name}@{mach}" if mach else name
    m = new_msg(where, body, channel, reply_to)
    mail_append(m)
    if name in HUMAN_ALIASES and not mach:
        log_msg("in", "human", body, "delivered", channel=channel,
                msg_id=m["id"], reply_to=reply_to)
        print("delivered → human (web feed at http://127.0.0.1:9344)")
        return
    status = agent_status(name) if not mach else None
    if defer and not mach and status in ("working", "blocked"):
        pend_append(m)
        print(f"queued → {where}  (busy — coalesces into one turn on idle; --now overrides)")
        log_msg("out", where, body, "queued", mach, channel=channel,
                msg_id=m["id"], reply_to=reply_to)
        return
    msgs = pend_drain(name) + [m]
    receipt, detail = deliver(name, merged_envelope(msgs), mach)
    print(f"{receipt} → {where}" + (f"  ({detail})" if detail else ""))
    log_msg("out", where, body, receipt, mach, channel=channel,
            msg_id=m["id"], reply_to=reply_to)


def cmd_send(args):
    body = " ".join(args.message)
    mine = os.environ.get("HERDR_PANE_ID")
    targets, channel = [], None
    if args.to == "all":
        targets = [(agent_addr(a), args.machine)
                   for a in roster(args.machine) if a.get("pane_id") != mine]
        if not targets:
            die("roster is empty — nobody to broadcast to")
        print(f"broadcast → {len(targets)} agents (each spends a turn — prefer '#channel' when team-scoped)")
    elif args.to.startswith("#"):
        ws = resolve_channel(args.to, args.machine)
        channel = ws["workspace_id"]
        # channels are workspace-scoped: only members post (operators/humans exempt)
        my_ws = my_workspace(args.machine)
        if my_ws is not None and my_ws != channel:
            die(f"not a member of #{ws.get('label') or channel} — "
                "channels are scoped to their workspace")
        targets = [(agent_addr(a), args.machine)
                   for a in roster(args.machine)
                   if a.get("workspace_id") == channel and a.get("pane_id") != mine]
        if not targets:
            die(f"#{ws.get('label') or channel} has no agents to broadcast to")
    else:
        targets = [split_target(args.to, args.machine)]
    for name, mach in targets:
        send_to(name, mach, body, channel, defer=not args.now)


def cmd_reply(args):
    orig = mail_find(args.msg_id)
    if not orig:
        die(f"message '{args.msg_id}' not in local mail — reply with: "
            "hirc send '<from-addr>' \"msg\" (address is in the [hirc ... from ...] header)")
    target = orig["from"] if "@" in orig["from"] else orig["from"]
    name, mach = split_target(target, None)
    send_to(name, mach, " ".join(args.message), reply_to=orig["id"], defer=not args.now)


def cmd_inbox(args):
    me = my_inbox_addr()
    seen = 0 if args.all else seen_ts(me)
    msgs = [m for m in mail_scan()
            if addr_base(m.get("to")) == me and m.get("ts", 0) > seen]
    if not msgs:
        print("(no new mail)" if not args.all else "(inbox empty)")
        return
    latest = seen
    for m in msgs:
        ts = time.strftime("%H:%M:%S", time.localtime(m["ts"]))
        tag = f" · #{m['channel']}" if m.get("channel") else ""
        tag += f" · re:{m['reply_to']}" if m.get("reply_to") else ""
        print(f"[{m['id']}] {ts} {m['from']}{tag}:")
        print(f"  {m['body']}")
        latest = max(latest, m["ts"])
    if not args.peek:
        mark_seen(me, latest)


def cmd_check(_args):
    """Cheap mail check — mtime short-circuit, ~0 work when nothing changed."""
    me = my_inbox_addr()
    cache_file = os.path.join(MAIL_DIR, f".check-{_fname(me)}.json")
    try:
        max_mtime = max((os.stat(os.path.join(MAIL_DIR, f)).st_mtime
                         for f in os.listdir(MAIL_DIR) if f.startswith("out-")),
                        default=0)
    except OSError:
        max_mtime = 0
    try:
        cache = json.load(open(cache_file))
    except (OSError, json.JSONDecodeError):
        cache = {}
    if cache.get("max_mtime") == max_mtime:
        n = cache.get("n", 0)
    else:
        seen = seen_ts(me)
        n = sum(1 for m in mail_scan()
                if addr_base(m.get("to")) == me and m.get("ts", 0) > seen)
        try:
            os.makedirs(MAIL_DIR, exist_ok=True)
            with open(cache_file, "w") as f:
                json.dump({"max_mtime": max_mtime, "n": n}, f)
        except OSError:
            pass
    print(f"{n} new" if n else "no new mail")
    sys.exit(0 if n else 1)


def flush_keys(target):
    """A pending queue can be keyed by name or pane id — drain both."""
    keys = {addr_base(target)}
    for a in roster():
        if addr_base(target) in (a.get("name"), a.get("pane_id")):
            keys |= {a.get("pane_id"), a.get("name")}
    return keys - {None}


def cmd_flush(args):
    """Deliver queued (coalesced) messages for a target, or all targets."""
    if args.to:
        keys = flush_keys(args.to)
        targets = sorted(k for k in keys if k in pend_all() or
                         os.path.exists(os.path.join(PEND_DIR, _fname(k) + ".jsonl")))
        if not targets:
            print("(nothing pending)")
            return
    else:
        targets = pend_all()
        if not targets:
            print("(nothing pending)")
            return
    for t in targets:
        msgs = pend_drain(t)
        if not msgs:
            continue
        addr = msgs[0].get("to", t)  # file stem is sanitized; msg.to is the real address
        if args.if_idle and agent_status(addr) in ("working", "blocked"):
            for m in msgs:
                pend_append(m)
            continue
        receipt, detail = deliver(addr, merged_envelope(msgs), None)
        if not receipt.startswith("delivered"):   # keep pending durable on failure
            for m in msgs:
                pend_append(m)
        print(f"{receipt} → {addr} ({len(msgs)} msg)" + (f"  ({detail})" if detail else ""))
        log_msg("out", addr, f"[{len(msgs)} coalesced]", receipt)


def cmd_ask(args):
    if args.to.startswith("#"):
        die("ask targets one agent — use send for channels")
    name, mach = split_target(args.to, args.machine)
    where = f"{name}@{mach}" if mach else name
    body = " ".join(args.message)
    m = new_msg(where, body)
    mail_append(m)
    msgs = (pend_drain(name) if not mach else []) + [m]
    text = merged_envelope(msgs)
    ms = args.timeout or 120000
    ok, _, err = herdr(["agent", "prompt", name, text, "--wait", "--timeout", str(ms)], machine=mach)
    if not ok:
        code = err.get("code", "error")
        print(f"{'blocked' if code == 'agent_blocked' else f'failed:{code}'} → {where}  ({err.get('message','')})")
        log_msg("out", where, body, code, mach)
        sys.exit(1)
    log_msg("out", where, body, "delivered+settled", mach)
    ok, out, _ = herdr(["agent", "read", name, "--source", "recent-unwrapped", "--lines", str(args.lines)], machine=mach)
    print(out if ok else f"hirc: prompt settled but read failed — try: hirc read {where}")


def cmd_read(args):
    name, mach = split_target(args.to, args.machine)
    ok, out, err = herdr(["agent", "read", name, "--source", args.source, "--lines", str(args.lines)], machine=mach)
    if not ok:
        die(f"read failed: {err.get('code')} — {err.get('message')}")
    sys.stdout.write(out if out.endswith("\n") else out + "\n")


def cmd_wait(args):
    name, mach = split_target(args.to, args.machine)
    cmd = ["agent", "wait", name]
    for u in args.until or []:
        cmd += ["--until", u]
    if args.timeout:
        cmd += ["--timeout", str(args.timeout)]
    ok, data, err = herdr(cmd, machine=mach)
    if not ok:
        die(f"wait failed: {err.get('code')} — {err.get('message')}")
    print(json.dumps(data, indent=1) if args.json else f"{name}: settled")


def cmd_machines(args):
    ok, data, err = herdr(["machine", "list", "--json"])
    if not ok:
        die(f"machine list failed: {err.get('code')} — {err.get('message')}")
    if not data:
        print("(no saved machines — add one with: herdr machine add)")
        return
    if args.json:
        print(json.dumps(data, indent=1))
        return
    for m in data:
        print(f"{m.get('label') or m.get('id') or '?':<20} {m.get('ssh_target') or m.get('target') or ''}  enabled={m.get('enabled', '?')}")


def cmd_log(args):
    try:
        lines = open(LOG_FILE).read().splitlines()
    except OSError:
        print("(no messages logged yet)")
        return
    # agent panes see only their workspace's traffic + own DMs; --all or an
    # operator shell (no pane) sees everything
    if not args.all and os.environ.get("HERDR_PANE_ID"):
        me, my_ws = my_address(), my_workspace()
        members = ws_members(my_ws) if my_ws else set()
        me_base = addr_base(me)

        def visible(m):
            if m.get("channel") == my_ws:
                return True
            frm, to = addr_base(m.get("from")), addr_base(m.get("to"))
            if me_base in (frm, to):
                return True
            return frm in members and to in members
        lines = [l for l in lines if _log_visible(l, visible)]
    for line in lines[-args.lines:]:
        try:
            m = json.loads(line)
            ts = time.strftime("%H:%M:%S", time.localtime(m["ts"]))
            body = m["body"] if len(m["body"]) <= 80 else m["body"][:77] + "..."
            print(f"{ts}  {m['dir']} → {m['to']}  [{m['result']}]  {body}")
        except (json.JSONDecodeError, KeyError):
            print(line)


def _log_visible(line, pred):
    try:
        return pred(json.loads(line))
    except (json.JSONDecodeError, KeyError):
        return True


def cmd_stats(args):
    msgs = mail_scan()
    if not msgs:
        print("(no mail yet)")
        return
    from collections import Counter
    by_from = Counter(addr_base(m.get("from")) for m in msgs)
    by_to = Counter(addr_base(m.get("to")) for m in msgs)
    by_day = Counter(time.strftime("%Y-%m-%d", time.localtime(m["ts"])) for m in msgs)
    n_chan = sum(1 for m in msgs if m.get("channel"))
    print(f"{len(msgs)} messages · {len(by_from)} senders · {n_chan} channel posts\n")
    print("TOP SENDERS          TOP TARGETS")
    top_s = by_from.most_common(6)
    top_t = by_to.most_common(6)
    for i in range(max(len(top_s), len(top_t))):
        s = f"{top_s[i][0]} ({top_s[i][1]})" if i < len(top_s) else ""
        t = f"{top_t[i][0]} ({top_t[i][1]})" if i < len(top_t) else ""
        print(f"  {s:<20} {t}")
    print("\nPER DAY")
    for day in sorted(by_day):
        print(f"  {day}  {'█' * min(40, by_day[day])} {by_day[day]}")


def cmd_skill(_args):
    try:
        sys.stdout.write(open(SKILL_PATH).read())
    except OSError:
        die(f"skill doc not found at {SKILL_PATH}")


# --- MCP adapter -------------------------------------------------------------
# `hirc mcp` is a stdio JSON-RPC server exposing the CLI as MCP tools, so
# MCP-capable harnesses (Claude Code, Codex, ...) get hirc natively.
# Subcommands run as subprocesses so tool output never pollutes stdout.

MCP_TOOLS = [
    ("hirc_whoami", "Your hirc address and status", {}),
    ("hirc_list", "Roster of live agents (addresses, kinds, status, workspaces)", {}),
    ("hirc_send", "Send a message to a peer. to = agent name, pane id, '#workspace' channel, 'all', or 'human'",
     {"to": {"type": "string"}, "message": {"type": "string"}, "now": {"type": "boolean"}}),
    ("hirc_reply", "Reply to a message by its short id", {"id": {"type": "string"}, "message": {"type": "string"}}),
    ("hirc_inbox", "Read your durable mail (marks seen unless peek=true)",
     {"peek": {"type": "boolean"}, "all": {"type": "boolean"}}),
    ("hirc_check", "Cheap check: exits non-zero unless new mail waits", {}),
    ("hirc_read", "Tail a peer's live output", {"to": {"type": "string"}, "lines": {"type": "integer"}}),
    ("hirc_wait", "Block until a peer settles", {"to": {"type": "string"}, "until": {"type": "string"}, "timeout": {"type": "integer"}}),
    ("hirc_log", "Message log scoped to your workspace", {"lines": {"type": "integer"}, "all": {"type": "boolean"}}),
    ("hirc_flush", "Deliver queued coalesced messages", {"to": {"type": "string"}}),
]


def _mcp_call(tool, a):
    """Map an MCP tool call to a hirc subprocess invocation."""
    exe = os.path.realpath(__file__)
    cmd = {"hirc_whoami": [exe, "whoami"], "hirc_list": [exe, "list"],
           "hirc_check": [exe, "check"], "hirc_skill": [exe, "skill"]}.get(tool)
    if cmd is None:
        if tool == "hirc_send":
            cmd = [exe, "send", str(a["to"]), str(a["message"])] + (["--now"] if a.get("now") else [])
        elif tool == "hirc_reply":
            cmd = [exe, "reply", str(a["id"]), str(a["message"])]
        elif tool == "hirc_inbox":
            cmd = [exe, "inbox"] + (["--peek"] if a.get("peek") else []) + (["--all"] if a.get("all") else [])
        elif tool == "hirc_read":
            cmd = [exe, "read", str(a["to"]), "--lines", str(a.get("lines", 60))]
        elif tool == "hirc_wait":
            cmd = [exe, "wait", str(a["to"])]
            if a.get("until"): cmd += ["--until", str(a["until"])]
            if a.get("timeout"): cmd += ["--timeout", str(a["timeout"])]
        elif tool == "hirc_log":
            cmd = [exe, "log", "--lines", str(a.get("lines", 20))] + (["--all"] if a.get("all") else [])
        elif tool == "hirc_flush":
            cmd = [exe, "flush"] + ([str(a["to"])] if a.get("to") else [])
        else:
            return None
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=150)
        return (p.stdout + p.stderr).strip() or "(no output)", p.returncode
    except subprocess.TimeoutExpired:
        return "hirc: timed out", 124


def cmd_mcp(_args):
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
        except json.JSONDecodeError:
            continue
        mid, method = req.get("id"), req.get("method", "")
        if mid is None:                       # notification — no response
            continue
        if method == "initialize":
            out = {"protocolVersion": req.get("params", {}).get("protocolVersion", "2024-11-05"),
                   "capabilities": {"tools": {}},
                   "serverInfo": {"name": "hirc", "version": VERSION}}
        elif method == "ping":
            out = {}
        elif method == "tools/list":
            out = {"tools": [{"name": n, "description": d,
                              "inputSchema": {"type": "object", "properties": props,
                                              "required": [k for k, v in props.items()
                                                         if v["type"] == "string" and k in ("to", "message", "id")]}}
                             for n, d, props in MCP_TOOLS]}
        elif method == "tools/call":
            p = req.get("params", {})
            res = _mcp_call(p.get("name"), p.get("arguments") or {})
            if res is None:
                sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": mid,
                    "error": {"code": -32602, "message": "unknown tool"}}) + "\n")
                sys.stdout.flush()
                continue
            text, rc = res
            out = {"content": [{"type": "text", "text": text}], "isError": rc != 0}
        else:
            sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": mid,
                "error": {"code": -32601, "message": f"unknown method {method}"}}) + "\n")
            sys.stdout.flush()
            continue
        sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": mid, "result": out}) + "\n")
        sys.stdout.flush()


def main():
    import argparse
    ap = argparse.ArgumentParser(prog="hirc", description="IRC-style messaging between Herdr agents",
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    ap.add_argument("--version", action="version", version=f"hirc {VERSION}")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def common(p, target=False, machine=True):
        if machine:
            p.add_argument("--machine", help="saved Herdr machine profile for remote agents")
        if target:
            p.add_argument("to", help="agent name, pane id, 'name@machine', or 'all'")

    p = sub.add_parser("whoami", help="your address and status"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_whoami)
    p = sub.add_parser("list", help="roster of live agents"); common(p); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_list)
    p = sub.add_parser("nick", help="register a name for your pane"); p.add_argument("name"); p.set_defaults(fn=cmd_nick)
    p = sub.add_parser("send", help="fire-and-forget message"); common(p, target=True)
    p.add_argument("message", nargs="+"); p.add_argument("--now", action="store_true", help="deliver immediately even if the peer is busy (no coalescing)")
    p.set_defaults(fn=cmd_send)
    p = sub.add_parser("reply", help="reply to a message by id"); p.add_argument("msg_id"); p.add_argument("message", nargs="+")
    p.add_argument("--now", action="store_true"); p.set_defaults(fn=cmd_reply)
    p = sub.add_parser("inbox", help="show unread mail addressed to you (durable)")
    p.add_argument("--peek", action="store_true", help="don't mark as read"); p.add_argument("--all", action="store_true", help="include already-read")
    p.set_defaults(fn=cmd_inbox)
    p = sub.add_parser("check", help="exit 0 if you have new mail (cheap)"); p.set_defaults(fn=cmd_check)
    p = sub.add_parser("flush", help="deliver queued coalesced messages now")
    p.add_argument("to", nargs="?", help="target (default: all pending)")
    p.add_argument("--if-idle", action="store_true", help="skip targets that are still working/blocked")
    p.set_defaults(fn=cmd_flush)
    p = sub.add_parser("ask", help="send and print the peer's reply"); common(p, target=True); p.add_argument("message", nargs="+"); p.add_argument("--timeout", type=int, help="ms to wait for the peer to settle (default 120000)"); p.add_argument("--lines", type=int, default=80); p.set_defaults(fn=cmd_ask)
    p = sub.add_parser("read", help="tail a peer's output"); common(p, target=True); p.add_argument("--lines", type=int, default=60); p.add_argument("--source", default="recent-unwrapped", choices=["visible", "recent", "recent-unwrapped", "detection"]); p.set_defaults(fn=cmd_read)
    p = sub.add_parser("wait", help="block until a peer settles"); common(p, target=True); p.add_argument("--until", action="append", help="status to wait for (repeatable)"); p.add_argument("--timeout", type=int, help="ms"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_wait)
    p = sub.add_parser("machines", help="saved SSH machine profiles"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_machines)
    p = sub.add_parser("log", help="message log (agents see their workspace; --all = everything)")
    p.add_argument("--lines", type=int, default=20); p.add_argument("--all", action="store_true", help="operator view: unscoped log")
    p.set_defaults(fn=cmd_log)
    p = sub.add_parser("skill", help="print the agent skill doc"); p.set_defaults(fn=cmd_skill)
    p = sub.add_parser("mcp", help="serve hirc as MCP tools over stdio"); p.set_defaults(fn=cmd_mcp)
    p = sub.add_parser("stats", help="mail usage stats (who talks to whom, per day)"); p.set_defaults(fn=cmd_stats)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
